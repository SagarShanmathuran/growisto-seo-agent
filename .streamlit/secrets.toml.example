# Streamlit secrets template
# Local dev:    Copy to .streamlit/secrets.toml and fill in values
# Production:   Paste these into Streamlit Cloud → Settings → Secrets

# Password gate for the dashboard. Required in production.
APP_PASSWORD = "change-me-to-a-long-random-string"

# Ahrefs API token — same one your MCP/UI uses
# Get from: https://ahrefs.com/api/profile
AHREFS_API_TOKEN = "your-ahrefs-token-here"

# Gemini API key — used for peer-brand discovery + verdict synthesis
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY = "AIza...your-key..."

# SearchAPI.io key (only used as fallback when Ahrefs is unavailable)
# Get from: https://www.searchapi.io/dashboard
SEARCHAPI_KEY = "your-searchapi-key-here"
